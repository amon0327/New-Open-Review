  "notes": {
    "purpose": "Analytics機能のテストモード用データベーススキーマ",
    "usage": "テストモード切り替え時にこれらのテーブルからデータを取得する",
    "mixed_references": "一部のテーブルは本番テーブル（review_forms, users, question_option_choices, review_question_answers）への外部キー参照を含む",
    "typos": [
      "test_review_questions.review_fome_id should be review_form_id",
      "test_review_questions.pege_number should be page_number"
    ]
  }
