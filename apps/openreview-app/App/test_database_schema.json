  "relationships": {
    "user_hierarchy": {
      "test_business_users": ["test_review_forms"],
      "test_users": ["test_review_form_submissions"]
    },
    "form_structure": {
      "test_review_forms": ["test_review_form_pages", "test_review_questions"],
      "test_review_form_pages": ["test_review_questions"]
    },
    "question_options": {
      "test_review_questions": ["test_question_option_choices", "test_question_option_linear_scale"]
