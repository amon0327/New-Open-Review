# Supabase Edge Functions 環境変数設定例

# プロジェクトURL（Supabaseダッシュボードから取得）
SUPABASE_URL=https://otfreskkeaenahqziriz.supabase.co

# 匿名キー（Supabaseダッシュボードから取得）
SUPABASE_ANON_KEY=your_anon_key_here

# サービスロールキー（Supabaseダッシュボードから取得）
# 重要: このキーは絶対に公開しないでください
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# プロジェクトID
PROJECT_ID=otfreskkeaenahqziriz

# アクセストークン（Supabaseダッシュボードから取得）
SUPABASE_ACCESS_TOKEN=your_access_token_here