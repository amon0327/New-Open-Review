# 🚨 OpenReview App - 環境変数テンプレート
# 本番運用時は .env.local にコピーして実際の値を設定してください

# 🔑 Supabase Configuration (必須)
REACT_APP_SUPABASE_URL=https://otfreskkeaenahqziriz.supabase.co
REACT_APP_SUPABASE_ANON_KEY=ここに実際のSupabase_Anon_Keyを設定

# ⚙️ Application Settings
REACT_APP_API_TIMEOUT=30000
REACT_APP_DEBUG_MODE=false

# 🌐 Production Settings (本番環境でのみ設定)
REACT_APP_PRODUCTION_DOMAIN=your-domain.com

# ⚠️ 重要な注意事項:
# 1. 実際の値は .env.local ファイルに記載してください
# 2. .env.local は絶対にGitにコミットしないでください
# 3. APIキーの漏洩は金銭的被害に直結します
# 4. 環境変数が設定されていないとアプリは起動しません

# 🔧 セットアップ手順:
# 1. このファイルを .env.local にコピー
# 2. REACT_APP_SUPABASE_ANON_KEY に実際の値を設定
# 3. アプリを再起動